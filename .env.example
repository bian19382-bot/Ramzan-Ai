# Gemini API key: keep this server-side; never use a VITE_ prefix for secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase browser configuration (publishable values, safe to expose in the client).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_project_key"
