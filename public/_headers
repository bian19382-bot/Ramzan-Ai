# Cloudflare Pages Production Headers & Security Policy

# Immutable cache for versioned/hashed static build artifacts
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure HTML entry points always fetch the latest version without stale client caches
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/404.html
  Cache-Control: no-cache, no-store, must-revalidate

# Global Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://generativelanguage.googleapis.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self';
